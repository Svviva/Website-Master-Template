---
import BaseLayout from '../../layouts/BaseLayout.astro';import{getEntry}from'astro:content';let settings;try{settings=await getEntry('settings','site')}catch{}const data=settings?.data;const email=data?.email||'SCHOOL_EMAIL',phone=data?.phone||'SCHOOL_PHONE',wa=(data?.whatsappNumber||'').replace(/[^0-9]/g,'');const waUrl=wa?`https://wa.me/${wa}`:'#';
---
<BaseLayout title="Admissions | SCHOOL NAME" lang="en" description="Contact SCHOOL NAME for current admissions information."><section class="page-hero"><div class="wrap"><p class="eyebrow">Admissions · GRADE RANGE</p><h1>Begin your child’s journey at SCHOOL NAME</h1><p>Replace this introduction with the new school’s approved admissions message and verified grade range.</p><div class="hero-actions"><a class="btn-primary" href={`${waUrl}?text=${encodeURIComponent('Hello SCHOOL NAME. I would like information about admissions.')}`} target="_blank" rel="noopener">Ask on WhatsApp</a></div></div></section><section class="block wrap intro-grid"><div><p class="kicker">Admissions information</p><h2>Contact the school for current requirements</h2><p class="lead">Add the school’s verified admissions requirements, required documents, fees, seat availability and arrangements here, or direct families to the school for current information.</p><p class="lead">Do not copy fees, requirements or admission procedures from another school without verification.</p></div><aside class="contact-card"><h2>Admissions contact</h2><p>Use the verified contact details entered in the master settings.</p><a href={`tel:${phone}`}>☎ {phone}</a><a href={`mailto:${email}`}>✉ {email}</a><a class="wa" href={`${waUrl}?text=${encodeURIComponent('Hello SCHOOL NAME. I have an admissions question about: ')}`} target="_blank" rel="noopener">Message admissions on WhatsApp</a><small>Confirm current fees, seat availability, documents and admission arrangements before publication.</small></aside></section><section class="whatsapp-band"><div class="wrap whatsapp-box"><div><p class="kicker">Admission enquiries</p><h2>Have a question about joining SCHOOL NAME?</h2><p>Families can send admissions questions directly to the school through WhatsApp.</p></div><a class="wa-large" href={`${waUrl}?text=${encodeURIComponent('Hello SCHOOL NAME. I would like to ask about admissions: ')}`} target="_blank" rel="noopener">Contact us on WhatsApp</a></div></section></BaseLayout>
<style>.page-hero{background:linear-gradient(90deg,rgba(4,34,62,.94),rgba(4,34,62,.58)),url('/images/school/07-creative-activity.jpg') center 45%/cover;color:#fff;padding:96px 0}.page-hero .eyebrow,.kicker{font-size:12px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:#d5a43f;margin-bottom:10px}.page-hero h1{font-family:var(--font-display);font-size:clamp(36px,5vw,55px);line-height:1.08;max-width:760px;margin-bottom:18px}.page-hero p{max-width:680px;color:#eef5fb;font-size:17px}.hero-actions{display:flex;gap:12px;flex-wrap:wrap;margin-top:28px}.block{padding-top:78px;padding-bottom:78px}.intro-grid{display:grid;grid-template-columns:minmax(0,1.5fr) minmax(280px,.7fr);gap:70px}.intro-grid h2,.whatsapp-band h2{font-family:var(--font-display);font-size:32px;color:var(--navy-dark);margin-bottom:28px}.lead{color:var(--slate);font-size:16px;line-height:1.8;max-width:720px;margin-bottom:18px}.contact-card{background:var(--cream);border:1px solid #e5e9ee;border-radius:14px;padding:30px;height:max-content}.contact-card h2{font-size:24px;margin-bottom:10px}.contact-card p{color:var(--slate);margin-bottom:20px}.contact-card a{display:block;color:var(--navy);font-weight:700;text-decoration:none;margin:12px 0;overflow-wrap:anywhere}.contact-card .wa{background:#fff;border:1px solid #dfe5ea;padding:12px 14px;border-radius:8px;margin-top:20px}.contact-card small{display:block;color:var(--slate);margin-top:22px;line-height:1.6}.whatsapp-band{background:var(--cream);padding:70px 0}.whatsapp-box{display:flex;align-items:center;justify-content:space-between;gap:50px}.whatsapp-box p:last-child{color:var(--slate);line-height:1.8}.wa-large{flex:none;background:#edf8f1;border:1px solid #cfe9d8;color:#176b38;text-decoration:none;font-weight:700;padding:16px 22px;border-radius:8px}@media(max-width:800px){.page-hero{padding:70px 0;background-position:center}.intro-grid{grid-template-columns:1fr;gap:38px}.block{padding-top:58px;padding-bottom:58px}.whatsapp-box{align-items:flex-start;flex-direction:column;gap:24px}.whatsapp-band{padding:55px 0}}</style>