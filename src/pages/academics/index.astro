---
import BaseLayout from '../../layouts/BaseLayout.astro';
const needs=[['Subjects by grade','Add the verified subject list, teaching language, weekly lesson allocation and electives for the new school.'],['Assessment','Add the school’s verified assessment, reporting, examination, grading and progression information.'],['Learning support','Add verified information about academic, language and inclusion support.'],['Homework & parent reporting','Add the school’s homework expectations, parent communication, reports and meeting arrangements.'],['Academic calendar & school day','Add verified term dates, school hours, lesson length and break times.']];
---
<BaseLayout title="Academics | SCHOOL NAME" lang="en" description="Explore learning and academics at SCHOOL NAME.">
<section class="hero"><div class="wrap"><p>Academics · GRADE RANGE</p><h1>A clear learning journey, from strong foundations to growing independence</h1><span>Replace this introduction with verified information about the school’s grade range, learning environment and curriculum.</span></div></section>
<section class="intro wrap"><div><p class="kicker">Our academic approach</p><h2>Learning with purpose, confidence and curiosity</h2></div><p>Describe the school’s verified academic approach here, including the knowledge, skills and learning habits it aims to develop.</p></section>
<section class="learning-photos wrap" aria-label="Learning at the school"><figure><img src="/images/school/02-student-learning.jpg" alt="Replace with a genuine school learning photograph" loading="lazy"/><figcaption>Replace with an approved learning caption</figcaption></figure><figure><img src="/images/school/12-digital-learning.jpg" alt="Replace with a genuine school learning photograph" loading="lazy"/><figcaption>Replace with an approved learning caption</figcaption></figure></section>
<section class="cambridge"><div class="wrap cambridge-grid"><div><p class="kicker">Curriculum</p><h2>CURRICULUM HEADING</h2></div><div><p>Insert only curriculum, accreditation and affiliation information that has been verified by the new school.</p><p>Do not carry curriculum or accreditation claims from a previous school into a new project.</p></div></div></section>
<section class="journey"><div class="wrap"><p class="kicker">The learning journey</p><h2>Progress through the school</h2><div class="bands"><article><h3>GRADE BAND 1</h3><p>Add the verified learning priorities for this stage.</p></article><article><h3>GRADE BAND 2</h3><p>Add the verified learning priorities for this stage.</p></article><article><h3>GRADE BAND 3</h3><p>Add the verified learning priorities for this stage.</p></article></div></div></section>
<section class="principles wrap"><p class="kicker">What guides learning</p><h2>A balanced school experience</h2><div class="principle-grid"><article><h3>Strong foundations</h3><p>Customize this principle to match the new school’s verified educational approach.</p></article><article><h3>Language & communication</h3><p>Describe the school’s verified language and communication approach.</p></article><article><h3>Active participation</h3><p>Describe how the school encourages participation and responsibility for learning.</p></article><article><h3>Growth & wellbeing</h3><p>Describe the school’s verified approach to student growth and wellbeing.</p></article></div></section>
<section class="admin"><div class="wrap admin-grid"><div><p class="kicker">More information</p><h2>Academic information checklist</h2><p>Complete and verify these details with the new school before publication.</p></div><div class="needs">{needs.map(([title,body])=><details><summary>{title}</summary><p>{body}</p></details>)}</div></div></section>
<section class="cta"><div class="wrap"><h2>Have a question about learning?</h2><p>Contact the school for current academic information.</p><a class="btn-primary" href="/contact/">Ask the school</a></div></section>
</BaseLayout>
<style>.hero{background:linear-gradient(90deg,rgba(4,34,62,.94),rgba(4,34,62,.56)),url('/images/school/04-student-project.jpg') center 46%/cover;color:#fff;padding:96px 0}.hero>div>p,.kicker{font-size:12px;text-transform:uppercase;letter-spacing:.1em;font-weight:700;color:#d5a43f}.hero h1{font-family:var(--font-display);font-size:clamp(38px,5vw,56px);line-height:1.08;max-width:850px;margin:10px 0 18px}.hero span{display:block;max-width:720px;color:#eef5fb;font-size:17px;line-height:1.7}.intro{display:grid;grid-template-columns:1fr 1fr;gap:70px;padding-top:75px;padding-bottom:45px}.intro h2,.cambridge h2,.journey h2,.principles h2,.admin h2,.cta h2{font-family:var(--font-display);font-size:clamp(28px,3vw,38px);line-height:1.18;color:var(--navy-dark);margin-top:8px}.intro>p{color:var(--slate);line-height:1.8}.learning-photos{display:grid;grid-template-columns:1.15fr .85fr;gap:18px;padding-bottom:70px}.learning-photos figure{margin:0;position:relative;overflow:hidden;border-radius:14px;min-height:300px;background:#eef3f7}.learning-photos img{width:100%;height:100%;min-height:300px;object-fit:cover;display:block}.learning-photos figcaption{position:absolute;left:16px;bottom:16px;background:rgba(4,34,62,.88);color:#fff;padding:9px 13px;border-radius:8px;font-size:13px}.cambridge{background:#eef3f7;padding:70px 0}.cambridge-grid{display:grid;grid-template-columns:.75fr 1.25fr;gap:70px}.cambridge-grid>div:last-child>p{color:var(--slate);line-height:1.8;margin-bottom:16px}.journey{background:var(--cream);padding:70px 0}.bands{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;margin-top:30px}.bands article,.principle-grid article{background:#fff;border:1px solid #e5e9ed;border-radius:12px;padding:28px}.bands h3,.principle-grid h3{font-family:var(--font-display);color:var(--navy-dark);font-size:21px;margin:9px 0}.bands p,.principle-grid p,.admin p{color:var(--slate);font-size:14px;line-height:1.7}.principles{padding-top:75px;padding-bottom:75px}.principle-grid{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-top:28px}.admin{background:#eef3f7;padding:72px 0}.admin-grid{display:grid;grid-template-columns:.8fr 1.2fr;gap:60px}.needs{border-top:1px solid #ccd6df}details{border-bottom:1px solid #ccd6df}summary{cursor:pointer;font-weight:700;padding:18px 32px 18px 0;position:relative}summary:after{content:'+';position:absolute;right:4px;color:var(--navy);font-size:20px}details[open] summary:after{content:'–'}details p{padding:0 32px 18px 0}.cta{text-align:center;padding:70px 0}.cta p{color:var(--slate);margin:12px auto 24px;max-width:620px}@media(max-width:750px){.hero{padding:70px 0;background-position:center}.intro,.admin-grid,.learning-photos,.cambridge-grid{grid-template-columns:1fr;gap:28px}.bands,.principle-grid{grid-template-columns:1fr}.intro,.principles{padding-top:55px;padding-bottom:35px}.journey,.admin,.cambridge{padding:55px 0}}</style>