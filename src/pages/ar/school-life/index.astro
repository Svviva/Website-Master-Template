---
import BaseLayout from '../../../layouts/BaseLayout.astro';
---
<BaseLayout title="الحياة المدرسية | اسم المدرسة" lang="ar" description="اكتشف تجربة الطلاب والحياة المدرسية في اسم المدرسة."><section class="hero"><div class="wrap"><p>ما وراء الفصل الدراسي</p><h1>تجربة مدرسية تقوم على التعلم والانتماء والنمو</h1><span>استبدل هذا النص بوصف معتمد من المدرسة الجديدة للحياة المدرسية والأنشطة والمجتمع.</span></div></section><section class="intro wrap"><div><p>تجربة الطالب</p><h2>التعلم مستمر طوال اليوم المدرسي</h2></div><p>صف هنا نهج المدرسة الموثق في تجربة الطلاب والمشاركة والرفاه والأنشطة.</p></section><section class="life-photos wrap" aria-label="صور الحياة المدرسية"><figure class="life-main"><img src="/images/school/06-team-activity.jpg" alt="استبدلها بصورة حقيقية من المدرسة" loading="lazy"/><figcaption><b>وصف الصورة</b><span>استبدل هذا النص بوصف معتمد.</span></figcaption></figure><div class="life-side"><figure><img src="/images/school/09-sports-activity.jpg" alt="استبدلها بصورة حقيقية من المدرسة" loading="lazy"/><figcaption><b>وصف الصورة</b><span>استبدل هذا النص بوصف معتمد.</span></figcaption></figure><figure><img src="/images/school/08-girls-acrobatics.jpg" alt="استبدلها بصورة حقيقية من المدرسة" loading="lazy"/><figcaption><b>وصف الصورة</b><span>استبدل هذا النص بوصف معتمد.</span></figcaption></figure></div></section><section class="cards wrap"><article><h3>التعلم والاكتشاف</h3><p>خصص هذه البطاقة باستخدام معلومات موثقة من المدرسة الجديدة.</p></article><article><h3>اللغة والتواصل</h3><p>خصص هذه البطاقة بما يتوافق مع البيئة اللغوية الفعلية للمدرسة.</p></article><article><h3>الانتماء والرفاه</h3><p>أضف نهج المدرسة الموثق في الانتماء والرفاه ودعم الطلاب.</p></article><article><h3>الأنشطة والمشاركة</h3><p>أضف فقط الأنشطة والفرص التي تقدمها المدرسة فعلياً.</p></article></section><section class="cta"><div class="wrap"><h2>شاهد المدرسة في أجوائها اليومية</h2><a href="/ar/gallery/">استكشف معرض الصور ←</a></div></section><section class="join"><div class="wrap"><h2>هل ترغب في الانضمام إلى مجتمع مدرستنا؟</h2><p>استبدل هذا النص بدعوة القبول المعتمدة ونطاق الصفوف الموثق للمدرسة.</p><a class="btn-primary" href="/ar/admissions/">ابدأ استفسار القبول</a></div></section></BaseLayout><style>.hero{background:linear-gradient(rgba(4,34,62,.72),rgba(4,34,62,.8)),url('/images/hero-2.jpg') center/cover;color:#fff;padding:100px 0}.hero p,.intro>div>p{color:#d5a43f;font-weight:700}.hero h1,h2,h3{font-family:var(--font-display-ar)}.hero h1{font-size:clamp(36px,5vw,54px);line-height:1.5;max-width:850px}.hero span{display:block;max-width:700px;line-height:2}.intro{display:grid;grid-template-columns:1fr 1fr;gap:65px;padding-top:75px;padding-bottom:42px}.intro h2,.cta h2,.join h2{font-size:30px;color:var(--navy-dark)}.intro>p{color:var(--slate);line-height:2}.life-photos{display:grid;grid-template-columns:1.15fr .85fr;grid-template-rows:auto;gap:18px;align-items:stretch;padding-bottom:62px}.life-main{height:100%}.life-photos .life-main img{width:100%;height:100%;object-fit:cover;object-position:center top}.life-side{display:grid;grid-template-rows:minmax(0,45fr) minmax(0,55fr);gap:18px;height:100%;min-height:0}.life-photos figure{margin:0;position:relative;overflow:hidden;border-radius:16px;background:#eef3f7;box-shadow:0 16px 40px rgba(4,34,62,.1)}.life-side figure{min-height:0}.life-side img{display:block;width:100%;height:100%;object-fit:cover;object-position:center top;transition:transform .35s ease}.life-main img{display:block;transition:transform .35s ease}.life-photos figure:hover img{transform:scale(1.02)}.life-photos figcaption{position:absolute;right:14px;left:14px;bottom:14px;padding:13px 15px;border-radius:10px;background:rgba(4,34,62,.88);color:#fff;backdrop-filter:blur(5px)}.life-photos figcaption b,.life-photos figcaption span{display:block}.life-photos figcaption b{font-family:var(--font-display-ar);font-size:18px}.life-photos figcaption span{margin-top:3px;color:#e1eaf2;font-size:13px;line-height:1.7}.cards{display:grid;grid-template-columns:1fr 1fr;gap:18px;padding-bottom:75px}.cards article{background:var(--cream);padding:28px;border-radius:12px}.cards h3{font-size:21px;color:var(--navy-dark);margin:0 0 8px}.cards p{color:var(--slate);font-size:14px}.cta{background:#eef3f7;padding:58px 0}.cta .wrap{display:flex;justify-content:space-between;align-items:center}.cta a{color:var(--navy);font-weight:700;text-decoration:none}.join{background:var(--navy-dark);color:#fff;text-align:center;padding:70px 0}.join h2{color:#fff}.join p{color:#dce7f4;margin:12px auto 24px;max-width:650px}@media(max-width:700px){.hero{padding:70px 0}.intro,.cards,.life-photos{grid-template-columns:1fr}.intro{padding-top:55px;padding-bottom:35px}.life-photos{padding-bottom:50px}.life-main{height:auto}.life-photos .life-main img{height:auto;object-fit:initial}.life-side{grid-template-rows:none;gap:24px;height:auto}.life-side figure{height:auto}.life-side img{height:auto;object-fit:initial}.cta .wrap{display:block}.cta a{display:inline-block;margin-top:18px}}</style>