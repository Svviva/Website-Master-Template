---
import BaseLayout from '../../../layouts/BaseLayout.astro';
const needs=[['المواد حسب الصف','أضف قائمة المواد ولغة التدريس وعدد الحصص والمواد الاختيارية بعد التحقق منها مع المدرسة الجديدة.'],['التقييم','أضف معلومات التقييم والتقارير والاختبارات والدرجات والانتقال بين الصفوف بعد التحقق منها.'],['دعم التعلم','أضف معلومات موثقة عن الدعم الأكاديمي واللغوي والتعليمي.'],['الواجبات والتواصل مع أولياء الأمور','أضف توقعات الواجبات ووسائل التواصل والتقارير والاجتماعات الخاصة بالمدرسة.'],['التقويم واليوم الدراسي','أضف مواعيد الفصول وساعات الدوام ومدة الحصص والاستراحات بعد التحقق منها.']];
---
<BaseLayout title="التعليم | اسم المدرسة" lang="ar" description="تعرّف على التعليم والتعلم في اسم المدرسة.">
<section class="hero"><div class="wrap"><p>التعليم · نطاق الصفوف</p><h1>رحلة تعليمية واضحة، من الأسس القوية إلى الاستقلالية المتنامية</h1><span>استبدل هذه المقدمة بمعلومات موثقة عن صفوف المدرسة وبيئة التعلم والمنهج.</span></div></section>
<section class="intro wrap"><div><p class="kicker">نهجنا التعليمي</p><h2>تعلم هادف يبني الثقة والفضول</h2></div><p>أضف هنا وصفاً موثقاً لنهج المدرسة التعليمي والمعارف والمهارات وعادات التعلم التي تسعى إلى تنميتها.</p></section>
<section class="photo-story wrap" aria-label="التعلم في المدرسة"><figure><img src="/images/school/02-student-learning.jpg" alt="استبدلها بصورة تعليمية حقيقية من المدرسة" loading="lazy"/><figcaption>استبدل هذا النص بوصف معتمد للصورة.</figcaption></figure><figure><img src="/images/school/12-digital-learning.jpg" alt="استبدلها بصورة تعليمية حقيقية من المدرسة" loading="lazy"/><figcaption>استبدل هذا النص بوصف معتمد للصورة.</figcaption></figure></section>
<section class="cambridge"><div class="wrap cambridge-grid"><div><p class="kicker">المنهج</p><h2>عنوان المنهج</h2></div><div><p>أضف فقط معلومات المنهج والاعتماد والانتماءات التي تم التحقق منها مع المدرسة الجديدة.</p><p>لا تنقل ادعاءات المنهج أو الاعتماد من مدرسة سابقة إلى مشروع مدرسة جديدة.</p></div></div></section>
<section class="journey"><div class="wrap"><p class="kicker">الرحلة التعليمية</p><h2>التقدم عبر مراحل المدرسة</h2><div class="bands"><article><h3>المرحلة الأولى</h3><p>أضف أولويات التعلم الموثقة لهذه المرحلة.</p></article><article><h3>المرحلة الثانية</h3><p>أضف أولويات التعلم الموثقة لهذه المرحلة.</p></article><article><h3>المرحلة الثالثة</h3><p>أضف أولويات التعلم الموثقة لهذه المرحلة.</p></article></div></div></section>
<section class="principles wrap"><p class="kicker">ما يوجّه التعلم</p><h2>تجربة مدرسية متوازنة</h2><div class="principle-grid"><article><h3>أسس قوية</h3><p>خصص هذا المبدأ ليتوافق مع النهج التعليمي الموثق للمدرسة الجديدة.</p></article><article><h3>اللغة والتواصل</h3><p>صف نهج المدرسة الموثق في اللغة والتواصل.</p></article><article><h3>المشاركة الفاعلة</h3><p>صف كيف تشجع المدرسة المشاركة وتحمل مسؤولية التعلم.</p></article><article><h3>النمو والرفاه</h3><p>صف نهج المدرسة الموثق في دعم نمو الطلاب ورفاههم.</p></article></div></section>
<section class="admin"><div class="wrap admin-grid"><div><p class="kicker">معلومات إضافية</p><h2>قائمة المعلومات الأكاديمية</h2><p>أكمل هذه التفاصيل وتحقق منها مع المدرسة الجديدة قبل النشر.</p></div><div class="needs">{needs.map(([title,body])=><details><summary>{title}</summary><p>{body}</p></details>)}</div></div></section>
<section class="cta"><div class="wrap"><h2>لديك سؤال عن التعلم؟</h2><p>تواصل مع المدرسة للحصول على المعلومات الأكاديمية الحالية.</p><a class="btn-primary" href="/ar/contact/">اسأل المدرسة</a></div></section>
</BaseLayout>
<style>.hero{background:linear-gradient(270deg,rgba(4,34,62,.94),rgba(4,34,62,.56)),url('/images/school/04-student-project.jpg') center 46%/cover;color:#fff;padding:96px 0}.hero>div>p,.kicker{font-size:12px;letter-spacing:.04em;font-weight:700;color:#d5a43f}.hero h1{font-family:var(--font-display-ar);font-size:clamp(34px,5vw,50px);line-height:1.35;max-width:850px;margin:10px 0 18px}.hero span{display:block;max-width:720px;color:#eef5fb;font-size:17px;line-height:1.9}.intro{display:grid;grid-template-columns:1fr 1fr;gap:70px;padding-top:75px;padding-bottom:42px}.intro h2,.cambridge h2,.journey h2,.principles h2,.admin h2,.cta h2{font-family:var(--font-display-ar);font-size:clamp(26px,3vw,34px);line-height:1.5;color:var(--navy-dark);margin-top:8px}.intro>p{color:var(--slate);line-height:1.9}.photo-story{display:grid;grid-template-columns:1.12fr .88fr;gap:18px;padding-bottom:75px}.photo-story figure{margin:0;position:relative;overflow:hidden;border-radius:16px;background:#eef3f7}.photo-story img{display:block;width:100%;height:330px;object-fit:cover}.photo-story figcaption{position:absolute;right:14px;left:14px;bottom:14px;background:rgba(4,34,62,.86);color:#fff;border-radius:10px;padding:11px 14px;font-size:13px;line-height:1.7}.cambridge{background:#eef3f7;padding:70px 0}.cambridge-grid{display:grid;grid-template-columns:.75fr 1.25fr;gap:70px}.cambridge-grid>div:last-child>p{color:var(--slate);line-height:2;margin-bottom:16px}.journey{background:var(--cream);padding:70px 0}.bands{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;margin-top:30px}.bands article,.principle-grid article{background:#fff;border:1px solid #e5e9ed;border-radius:12px;padding:28px}.bands h3,.principle-grid h3{font-family:var(--font-display-ar);color:var(--navy-dark);font-size:20px;margin:9px 0}.bands p,.principle-grid p,.admin p{color:var(--slate);font-size:14px;line-height:1.9}.principles{padding-top:75px;padding-bottom:75px}.principle-grid{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-top:28px}.admin{background:#eef3f7;padding:72px 0}.admin-grid{display:grid;grid-template-columns:.8fr 1.2fr;gap:60px}.needs{border-top:1px solid #ccd6df}details{border-bottom:1px solid #ccd6df}summary{cursor:pointer;font-weight:700;padding:18px 0 18px 32px;position:relative}summary:after{content:'+';position:absolute;left:4px;color:var(--navy);font-size:20px}details[open] summary:after{content:'–'}details p{padding:0 0 18px 32px}.cta{text-align:center;padding:70px 0}.cta p{color:var(--slate);margin:12px auto 24px;max-width:620px}@media(max-width:750px){.hero{padding:70px 0;background-position:center}.intro,.admin-grid,.photo-story,.cambridge-grid{grid-template-columns:1fr;gap:28px}.bands,.principle-grid{grid-template-columns:1fr}.intro,.principles{padding-top:55px;padding-bottom:35px}.journey,.admin,.cambridge{padding:55px 0}}</style>