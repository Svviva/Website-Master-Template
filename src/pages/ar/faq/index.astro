---
import BaseLayout from '../../../layouts/BaseLayout.astro';const faqs=[['ما الصفوف التي تخدمها المدرسة؟','استبدل هذه الإجابة بنطاق الصفوف الموثق للمدرسة الجديدة ومعلومات توفر المقاعد الحالية.'],['كيف أستفسر عن القبول؟','استخدم قنوات القبول المعتمدة لدى المدرسة، مثل صفحة القبول أو الهاتف أو البريد الإلكتروني أو واتساب.'],['ما المستندات المطلوبة للقبول؟','أضف فقط المستندات والمتطلبات الحالية التي تم التحقق منها مع المدرسة الجديدة.'],['هل يحتاج طفلي إلى تقييم؟','اذكر هنا متطلبات التقييم أو اللقاء بعد التحقق منها مع المدرسة.'],['كيف أستفسر عن الرسوم؟','وجّه الأسر إلى المدرسة للحصول على معلومات الرسوم المعتمدة ما لم تزودك المدرسة برسوم معتمدة للنشر.'],['أين تقع المدرسة؟','أضف الموقع والاتجاهات الموثقة للمدرسة الجديدة.'],['كيف أتواصل مع المدرسة بسرعة؟','استخدم رقم الهاتف والبريد الإلكتروني وبيانات واتساب الموثقة والمعدّة للمدرسة الجديدة.']];
---
<BaseLayout title="الأسئلة الشائعة | اسم المدرسة" lang="ar" description="إجابات عن الأسئلة الشائعة للأسر حول اسم المدرسة."><section class="hero"><div class="wrap"><p>معلومات لأولياء الأمور</p><h1>الأسئلة الشائعة</h1><span>خصص هذه الإجابات باستخدام معلومات موثقة من المدرسة الجديدة قبل النشر.</span></div></section><section class="wrap faq"><div class="intro"><h2>لم تجد الإجابة؟</h2><p>فريق المدرسة جاهز لمساعدتك.</p><a href="/ar/contact/">اتصل بالمدرسة ←</a></div><div class="questions">{faqs.map(([q,a],i)=><details open={i===0}><summary>{q}</summary><p>{a}</p></details>)}</div></section><section class="admit"><div class="wrap"><h2>هل أنت مستعد للاستفسار عن مقعد لطفلك؟</h2><a class="btn-primary" href="/ar/admissions/">ابدأ استفسار القبول</a></div></section></BaseLayout><style>.hero{background:var(--navy-dark);color:#fff;padding:72px 0}.hero p{color:#d5a43f;font-weight:700}.hero h1,h2{font-family:var(--font-display-ar)}.hero h1{font-size:clamp(35px,5vw,50px);margin:8px 0}.hero span{color:#dce7f4}.faq{display:grid;grid-template-columns:.65fr 1.35fr;gap:65px;padding-top:72px;padding-bottom:78px}.intro h2{font-size:27px;color:var(--navy-dark)}.intro p{color:var(--slate);margin:8px 0 16px}.intro a{color:var(--navy);font-weight:700;text-decoration:none}.questions{border-top:1px solid #dfe5ea}details{border-bottom:1px solid #dfe5ea}summary{cursor:pointer;list-style:none;padding:21px 0;font-weight:700}details p{color:var(--slate);padding:0 0 21px;font-size:14px;line-height:1.9}.admit{background:#eef3f7;text-align:center;padding:62px 0}.admit h2{font-size:28px;color:var(--navy-dark);margin-bottom:20px}.admit .btn-primary{background:var(--navy);color:#fff}@media(max-width:720px){.faq{grid-template-columns:1fr;gap:35px;padding-top:50px;padding-bottom:55px}.hero{padding:56px 0}}</style>