---
import BaseLayout from '../../../layouts/BaseLayout.astro';import{getEntry}from'astro:content';let settings;try{settings=await getEntry('settings','site')}catch{}const data=settings?.data;const email=data?.email||'SCHOOL_EMAIL',phone=data?.phone||'SCHOOL_PHONE',wa=(data?.whatsappNumber||'').replace(/[^0-9]/g,'');const waUrl=wa?`https://wa.me/${wa}`:'#';
---
<BaseLayout title="القبول | اسم المدرسة" lang="ar" description="تواصل مع اسم المدرسة للحصول على معلومات القبول الحالية."><section class="page-hero"><div class="wrap"><p>القبول · نطاق الصفوف</p><h1>ابدأ رحلة طفلك في اسم المدرسة</h1><span>استبدل هذه المقدمة برسالة القبول المعتمدة ونطاق الصفوف الموثق للمدرسة الجديدة.</span><div class="actions"><a class="btn-primary" href={`${waUrl}?text=${encodeURIComponent('مرحباً، أود الحصول على معلومات عن القبول في اسم المدرسة.')}`} target="_blank" rel="noopener">اسأل عبر واتساب</a></div></div></section><section class="block wrap grid"><div><p class="kicker">معلومات القبول</p><h2>تواصل مع المدرسة لمعرفة المتطلبات الحالية</h2><p class="lead">أضف متطلبات القبول والمستندات والرسوم وتوفر المقاعد والترتيبات بعد التحقق منها مع المدرسة، أو وجّه الأسر إلى المدرسة للحصول على المعلومات الحالية.</p><p class="lead">لا تنقل الرسوم أو المتطلبات أو إجراءات القبول من مدرسة أخرى دون التحقق منها.</p></div><aside><h2>التواصل بشأن القبول</h2><p>استخدم بيانات التواصل الموثقة والمدخلة في إعدادات القالب.</p><a href={`tel:${phone}`}>☎ {phone}</a><a href={`mailto:${email}`}>✉ {email}</a><a class="wa" href={`${waUrl}?text=${encodeURIComponent('مرحباً اسم المدرسة، لدي استفسار عن القبول بشأن: ')}`} target="_blank" rel="noopener">راسل قسم القبول عبر واتساب</a><small>تحقق من الرسوم وتوفر المقاعد والمستندات وترتيبات القبول قبل النشر.</small></aside></section><section class="wa-band"><div class="wrap wa-box"><div><p class="kicker">استفسارات القبول</p><h2>هل لديك سؤال عن الانضمام إلى اسم المدرسة؟</h2><p>يمكن للأسر إرسال استفسارات القبول مباشرة إلى المدرسة عبر واتساب.</p></div><a class="wa-large" href={`${waUrl}?text=${encodeURIComponent('مرحباً اسم المدرسة، أود الاستفسار عن القبول: ')}`} target="_blank" rel="noopener">تواصل معنا عبر واتساب</a></div></section></BaseLayout>
<style>.page-hero{background:linear-gradient(270deg,rgba(4,34,62,.94),rgba(4,34,62,.58)),url('/images/school/07-creative-activity.jpg') center 45%/cover;color:#fff;padding:96px 0}.page-hero>div>p,.kicker{color:#d5a43f;font-weight:700}.page-hero h1,h2{font-family:var(--font-display-ar)}.page-hero h1{font-size:clamp(35px,5vw,52px);margin:10px 0}.page-hero span{display:block;max-width:700px;line-height:2;color:#eef5fb}.actions{display:flex;gap:12px;margin-top:26px}.block{padding-top:75px;padding-bottom:75px}.grid{display:grid;grid-template-columns:1.4fr .7fr;gap:65px}.grid h2,.wa-box h2{font-size:28px;color:var(--navy-dark);margin-bottom:25px}.lead,aside p{color:var(--slate);font-size:15px;line-height:2;margin-bottom:16px}aside{background:var(--cream);padding:28px;border-radius:14px;height:max-content}aside a{display:block;color:var(--navy);font-weight:700;text-decoration:none;margin:13px 0;overflow-wrap:anywhere}aside small{display:block;color:var(--slate);margin-top:20px;line-height:1.8}.wa-band{background:var(--cream);padding:65px 0}.wa-box{display:flex;align-items:center;justify-content:space-between;gap:45px}.wa-box>div>p:last-child{color:var(--slate);line-height:2}.wa-large{flex:none;background:#edf8f1;border:1px solid #cfe9d8;color:#176b38;text-decoration:none;font-weight:700;padding:15px 22px;border-radius:8px}@media(max-width:760px){.page-hero{padding:70px 0;background-position:center}.grid{grid-template-columns:1fr}.actions{flex-direction:column}.block{padding-top:55px;padding-bottom:55px}.wa-box{align-items:flex-start;flex-direction:column;gap:22px}.wa-band{padding:50px 0}}</style>