---
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout title="About — SCHOOL NAME" lang="en">
  <section class="page-hero"><div class="wrap"><p class="eyebrow">About Us</p><h1>A community built on strong foundations</h1><p class="sub">SCHOOL NAME serves VERIFIED GRADE LEVELS in SCHOOL LOCATION within a welcoming learning environment.</p></div></section>
  <section class="block wrap two-col"><div><h2>Our story</h2><p>Add the school's verified history, identity and community story here.</p><p>Describe the school's educational approach and the qualities it seeks to develop in its students. Use only information confirmed by the school.</p></div><div><h2>Our mission</h2><p>Add the school's approved mission or a concise, verified summary of its educational purpose here.</p><h2 class="mt">Curriculum information</h2><p>Add the school's verified curriculum, subjects, affiliations or accreditation information here. Do not carry curriculum claims from another school into this website.</p><a class="text-link" href="/academics/">Explore academics →</a></div></section>
</BaseLayout>
<style>.page-hero{position:relative;background:linear-gradient(90deg,rgba(4,34,62,.92),rgba(4,34,62,.62)),url('/images/school/03-school-celebration.jpg') center 60%/cover;color:#fff;padding:92px 0}.page-hero .eyebrow{color:#d5a43f;font-size:14px;margin-bottom:12px}.page-hero h1{font-family:var(--font-display);font-size:clamp(36px,5vw,52px);font-weight:600;margin-bottom:14px;max-width:640px}.page-hero .sub{color:#eef5fb;max-width:560px;font-size:16px;line-height:1.7}.block{padding:64px 24px}.two-col{display:grid;grid-template-columns:1fr 1fr;gap:48px}h2{font-family:var(--font-display);font-size:22px;margin-bottom:12px;color:var(--navy-dark)}h2.mt{margin-top:28px}p{color:var(--ink);font-size:15px;line-height:1.7;margin-bottom:14px}.text-link{color:var(--navy);font-weight:600;text-decoration:none}@media(max-width:800px){.page-hero{padding:70px 0;background-position:center}.two-col{grid-template-columns:1fr}}</style>