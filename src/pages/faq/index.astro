---
import BaseLayout from '../../layouts/BaseLayout.astro';
const faqs=[['Which grades does the school serve?','Replace this answer with the new school’s verified grade range and current seat-availability guidance.'],['How do I enquire about admission?','Use the school’s approved admissions channels, such as the Admissions page, phone, email or WhatsApp.'],['What documents are required for admission?','Add only the current documents and requirements verified by the new school.'],['Does my child need an assessment?','State the school’s verified assessment or meeting requirements here.'],['How can I ask about fees?','Direct families to the school for current approved fee information unless the school has supplied fees for publication.'],['Where is the school located?','Add the new school’s verified location and directions information.'],['How can I contact the school quickly?','Use the verified phone, email and WhatsApp details configured for the new school.']];
---
<BaseLayout title="Frequently Asked Questions | SCHOOL NAME" lang="en" description="Answers to common parent questions about SCHOOL NAME."><section class="hero"><div class="wrap"><p>Parent information</p><h1>Frequently asked questions</h1><span>Customize these answers with verified information from the new school before publication.</span></div></section><section class="wrap faq"><div class="intro"><p>Can't find your answer?</p><h2>Our school team is ready to help.</h2><a href="/contact/">Contact the school →</a></div><div class="questions">{faqs.map(([q,a],i)=><details open={i===0}><summary>{q}</summary><p>{a}</p></details>)}</div></section><section class="admit"><div class="wrap"><h2>Ready to ask about a place for your child?</h2><a class="btn-primary" href="/admissions/">Start an admission enquiry</a></div></section></BaseLayout>
<style>.hero{background:var(--navy-dark);color:#fff;padding:76px 0}.hero p{color:#d5a43f;font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:.1em}.hero h1{font-family:var(--font-display);font-size:clamp(36px,5vw,52px);margin:8px 0}.hero span{color:#dce7f4}.faq{display:grid;grid-template-columns:.65fr 1.35fr;gap:70px;padding-top:75px;padding-bottom:80px}.intro>p{color:var(--gold);font-size:12px;font-weight:700;text-transform:uppercase}.intro h2{font-family:var(--font-display);color:var(--navy-dark);font-size:28px;margin:8px 0 18px}.intro a{color:var(--navy);font-weight:700;text-decoration:none}.questions{border-top:1px solid #dfe5ea}details{border-bottom:1px solid #dfe5ea;padding:0 4px}summary{cursor:pointer;list-style:none;padding:22px 35px 22px 0;font-weight:700;position:relative}summary::-webkit-details-marker{display:none}summary:after{content:'+';position:absolute;right:4px;color:var(--navy);font-size:22px;top:17px}details[open] summary:after{content:'–'}details p{color:var(--slate);padding:0 35px 22px 0;font-size:14px}.admit{background:#eef3f7;text-align:center;padding:65px 0}.admit h2{font-family:var(--font-display);color:var(--navy-dark);font-size:30px;margin-bottom:20px}.admit .btn-primary{background:var(--navy);color:#fff}@media(max-width:720px){.hero{padding:58px 0}.faq{grid-template-columns:1fr;gap:35px;padding-top:52px;padding-bottom:55px}}</style>