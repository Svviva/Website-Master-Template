---
import BaseLayout from '../layouts/BaseLayout.astro';import{getCollection,getEntry}from'astro:content';let settings;try{settings=await getEntry('settings','site')}catch{}const p=settings?.data;const school=p?.schoolName||'SCHOOL_NAME',location=p?.locationShort||'LOCATION',grades=p?.gradeRange||'GRADE_RANGE';let slides=[];try{slides=(await getCollection('hero-slides')).sort((a,b)=>a.data.order-b.data.order)}catch{}let news=[];try{news=(await getCollection('news')).sort((a,b)=>b.data.date.valueOf()-a.data.date.valueOf()).slice(0,3)}catch{}let singles=[],albums=[];try{singles=await getCollection('gallery-singles');albums=await getCollection('gallery-albums')}catch{}const gallery=[...albums.map(a=>({image:a.data.coverImage})),...singles.map(s=>({image:s.data.image}))].slice(0,5);const heroSlides=slides.map(s=>({image:s.data.image,headline:s.data.headline,subhead:s.data.subhead}));
---
<BaseLayout title={`${school} | ${location}`} lang="en" description={`Official website template for ${school}. Replace all placeholder content with verified school information before publication.`}><section class="hero" data-slides={JSON.stringify(heroSlides)}><div class="hero-bg"></div><div class="overlay"></div><div class="wrap hero-copy"><p>{school} · {location}</p><h1 id="hero-title">{heroSlides[0]?.headline||'SCHOOL_HEADLINE'}</h1><span id="hero-sub">{heroSlides[0]?.subhead||'SCHOOL_HERO_MESSAGE'}</span><div class="actions"><a class="btn-primary" href="/admissions/">Admissions</a><a class="ghost" href="/contact/">Contact the School</a></div><small>{grades} · Replace with verified admissions guidance</small></div>{heroSlides.length>1&&<div class="dots">{heroSlides.map((_,i)=><button class={i===0?'active':''} data-slide={i} aria-label={`Show slide ${i+1}`}></button>)}</div>}</section><section class="quick"><div class="wrap"><a href="/admissions/"><b>Admissions</b><span>Verified joining information →</span></a><a href="/academics/"><b>Academics</b><span>Explore the school’s learning approach →</span></a><a href="/school-life/"><b>School Life</b><span>Discover the student experience →</span></a><a href="/contact/"><b>Contact</b><span>Speak with the school team →</span></a></div></section><section class="welcome wrap"><div class="principal" style={p?.principalPhoto?`background-image:url(${p.principalPhoto})`:''} role="img" aria-label="Replace with approved principal photograph"></div><div><p class="kicker">A warm welcome</p><h2>PRINCIPAL_WELCOME_HEADING</h2><p>{p?.principalMessage||'PRINCIPAL_WELCOME_MESSAGE'}</p><a href="/about/">Discover our school →</a></div></section><section class="story"><div class="wrap"><div><p class="kicker">School experience</p><h2>Show genuine moments from the new school</h2><p>Replace the current project photographs and this text with approved photographs and verified descriptions supplied by the new school.</p><a href="/school-life/">Explore school life →</a></div><div class="photos"><figure><img src="/images/school/04-student-project.jpg" alt="Replace with genuine school photograph"/><figcaption>REPLACE PHOTO &amp; CAPTION</figcaption></figure><figure><img src="/images/school/12-digital-learning.jpg" alt="Replace with genuine school photograph"/><figcaption>REPLACE PHOTO &amp; CAPTION</figcaption></figure></div></div></section><section class="admit"><div class="wrap"><div><p class="kicker light">Admissions</p><h2>Interested in joining {school}?</h2><p>Replace this text with the school’s approved admissions invitation and current guidance.</p></div><div class="actions"><a class="btn-primary" href="/admissions/">Admission Enquiry</a><a class="ghost" href="/contact/">Ask a Question</a></div></div></section><section class="content wrap"><div class="head"><div><p class="kicker">Stay informed</p><h2>Latest news</h2></div><a href="/news/">View all →</a></div><div class="news">{news.length===0?<p>No school news has been added yet.</p>:news.map(post=><a href={`/news/${post.id}/`}><div class="thumb" style={`background-image:url(${post.data.coverImage})`}></div><small>{post.data.date.toLocaleDateString('en-GB')}</small><h3>{post.data.title}</h3></a>)}</div></section><section class="gallery"><div class="content wrap"><div class="head"><div><p class="kicker">Gallery</p><h2>Life at {school}</h2></div><a href="/gallery/">View gallery →</a></div><p class="template-note">Replace all inherited project photographs with genuine, approved photographs from the new school before publication.</p><div class="gallery-grid">{gallery.map((g,i)=><a href="/gallery/" aria-label={`Gallery placeholder ${i+1}`} style={`background-image:url(${g.image})`}></a>)}</div></div></section><section class="final"><div class="wrap"><h2>Discover {school}</h2><p>Replace this final invitation with approved wording from the new school.</p><div class="actions center"><a class="btn-primary" href="/admissions/">Admissions</a><a class="ghost" href="/contact/">Contact</a></div></div></section></BaseLayout>
<script>const hero=document.querySelector('.hero');if(hero){const slides=JSON.parse(hero.getAttribute('data-slides')||'[]'),bg=hero.querySelector('.hero-bg'),title=document.getElementById('hero-title'),sub=document.getElementById('hero-sub'),dots=[...hero.querySelectorAll('[data-slide]')];let current=0,timer;const show=i=>{if(!slides.length)return;current=i;bg.style.backgroundImage=`url(${slides[i].image})`;title.textContent=slides[i].headline;sub.textContent=slides[i].subhead||'';dots.forEach((d,n)=>d.classList.toggle('active',n===i))};const start=()=>{if(slides.length>1)timer=setInterval(()=>show((current+1)%slides.length),6000)};dots.forEach(d=>d.addEventListener('click',()=>{clearInterval(timer);show(Number(d.dataset.slide));start()}));show(0);start()}</script>
<style>.hero{position:relative;min-height:650px;display:flex;align-items:center;background:#05386b;overflow:hidden}.hero-bg,.overlay{position:absolute;inset:0}.hero-bg{background:center/cover}.overlay{background:linear-gradient(90deg,rgba(3,35,66,.94),rgba(5,56,107,.45))}.hero-copy{position:relative;color:#fff;z-index:2}.hero-copy>p,.kicker{color:#d5a43f;font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:.08em}.hero h1{font-family:var(--font-display);font-size:clamp(40px,5vw,62px);max-width:700px;margin:12px 0}.hero span{display:block;max-width:650px;line-height:1.8}.actions{display:flex;gap:12px;flex-wrap:wrap;margin-top:26px}.ghost{border:1px solid #fff;color:#fff;text-decoration:none;padding:12px 22px;border-radius:7px}.hero small{display:block;margin-top:20px}.dots{position:absolute;bottom:25px;left:50%;transform:translateX(-50%)}.dots button{width:28px;height:4px;border:0;margin:4px;background:#ffffff66}.dots .active{background:#fff}.quick{box-shadow:0 8px 30px #0e2a4614}.quick .wrap{display:grid;grid-template-columns:repeat(4,1fr)}.quick a{padding:26px 20px;text-decoration:none;border-right:1px solid #e8edf2}.quick b,.quick span{display:block}.quick b{color:var(--navy-dark);font-family:var(--font-display)}.quick span{font-size:12px;color:var(--slate);margin-top:5px}.welcome{display:grid;grid-template-columns:280px 1fr;gap:55px;align-items:center;padding-top:80px;padding-bottom:80px}.principal{height:320px;border-radius:16px;background:#d6e1ee center/cover}.welcome h2,.story h2,.admit h2,.head h2,.final h2{font-family:var(--font-display);font-size:clamp(28px,3vw,38px);color:var(--navy-dark)}.welcome p:not(.kicker),.story p:not(.kicker){color:var(--slate);line-height:1.8;margin:15px 0}.welcome a,.story a,.head a{color:var(--navy);font-weight:700;text-decoration:none}.story{background:#f3f6f8;padding:80px 0}.story>.wrap{display:grid;grid-template-columns:.75fr 1.25fr;gap:55px;align-items:center}.photos{display:grid;grid-template-columns:1.2fr .8fr;gap:14px}.photos figure{position:relative;margin:0;min-height:360px;border-radius:14px;overflow:hidden}.photos img{position:absolute;width:100%;height:100%;object-fit:cover}.photos figcaption{position:absolute;bottom:12px;left:12px;right:12px;background:#04223ed9;color:#fff;padding:12px;border-radius:8px}.admit{background:var(--navy-dark);color:#fff;padding:60px 0}.admit>.wrap{display:flex;justify-content:space-between;align-items:center;gap:40px}.admit h2{color:#fff}.admit p{color:#dbe9f7}.light{color:#cfe2f5}.content{padding-top:75px;padding-bottom:75px}.head{display:flex;justify-content:space-between;align-items:end;margin-bottom:28px}.news{display:grid;grid-template-columns:repeat(3,1fr);gap:22px}.news>a{border:1px solid #e7ebef;border-radius:12px;overflow:hidden;text-decoration:none;color:inherit;padding-bottom:18px}.thumb{height:180px;background:#e8edf2 center/cover}.news small,.news h3{display:block;margin:12px 18px 0}.gallery{background:var(--cream)}.template-note{color:var(--slate);margin:-10px 0 24px}.gallery-grid{display:grid;grid-template-columns:1.35fr 1fr 1fr;grid-template-rows:170px 170px;gap:12px}.gallery-grid a{background:#d6e1ee center/cover;border-radius:10px}.gallery-grid a:first-child{grid-row:span 2}.final{text-align:center;background:#074b8a;color:#fff;padding:75px 0}.final h2{color:#fff}.final p{margin:12px auto;color:#dbe9f7}.center{justify-content:center}@media(max-width:800px){.quick .wrap{grid-template-columns:1fr 1fr}.welcome{grid-template-columns:220px 1fr}.story>.wrap{grid-template-columns:1fr}.admit>.wrap{flex-direction:column;align-items:flex-start}.news{grid-template-columns:1fr 1fr}}@media(max-width:600px){.hero{min-height:560px}.quick .wrap,.welcome,.photos,.news,.gallery-grid{grid-template-columns:1fr}.principal{height:340px}.story,.content,.welcome{padding-top:55px;padding-bottom:55px}.photos figure{min-height:280px}.gallery-grid{grid-template-rows:auto}.gallery-grid a{min-height:220px}.gallery-grid a:first-child{grid-row:auto}.head{align-items:flex-start;flex-direction:column;gap:10px}.actions a{width:100%;text-align:center}}</style>